# Copy this file to .env and fill in your values.
# Generate a token at https://tempestwx.com/settings/tokens
#
# At least one data source is required, not both: this cloud pair, and/or
# TEMPEST_UDP_ENABLED below. Delete these two lines if you only want to run
# off the local UDP broadcast (no Tempest account/token needed for that).

TEMPEST_STATION_ID=104000
TEMPEST_TOKEN=your-token

# Optional (defaults shown)
# TEMPEST_UNITS=imperial
# PORT=8080
# POLL_INTERVAL_SECONDS=300
# DB_PATH=data/weather.db
# STATIC_DIR=static

# Docker Compose only: host-side port mapping (container always listens on
# PORT above). Change this if 8080 is already taken on your host.
# HOST_PORT=8080

# Optional: also/instead listen for your Tempest hub's local UDP broadcast
# (https://weatherflow.github.io/Tempest/api/udp/v171/) for ~1x/minute
# current-conditions + history updates, and station health monitoring. Only
# works if this service runs on the same local network as your Tempest hub -
# it's LAN broadcast traffic, not internet-routable.
# TEMPEST_UDP_ENABLED=true
# TEMPEST_UDP_PORT=50222
# TEMPEST_HUB_SERIAL=HB-00000000
