# Copy this file to .env and fill in your values.
# Generate a token at https://tempestwx.com/settings/tokens
#
# At least one data source is required, not both: this cloud pair, and/or
# TEMPEST_UDP_ENABLED below. Delete these two lines if you only want to run
# off the local UDP broadcast (no Tempest account/token needed for that).

TEMPEST_STATION_ID=104000
TEMPEST_TOKEN=your-token

# Optional (defaults shown)
# TEMPEST_UNITS: imperial or metric; the site and widget label values to
# match. History is stored as received and is not converted if you switch.
# TEMPEST_UNITS=imperial
# PORT=8080
# POLL_INTERVAL_SECONDS=300
# DB_PATH=data/weather.db
# STATIC_DIR=static

# Cloud source only: on startup, fill in history missed while the service
# was down (up to BACKFILL_MAX_DAYS back), in the background. Older holes can
# be filled with scripts/backfill_history.py - see the README.
# BACKFILL_ON_STARTUP=true
# BACKFILL_MAX_DAYS=30

# Optional: IANA timezone whose calendar days the daily history buckets
# follow. Normally leave unset - the timezone Tempest's cloud reports for
# your station is used (and remembered across restarts), else UTC. Set it
# for a UDP-only setup, or to override.
# STATION_TIMEZONE=America/Denver

# Docker Compose only: host-side port mapping (container always listens on
# PORT above). Change this if 8080 is already taken on your host.
# HOST_PORT=8080

# Optional: also/instead listen for your Tempest hub's local UDP broadcast
# (https://weatherflow.github.io/Tempest/api/udp/v171/) for ~1x/minute
# current-conditions + history updates, and station health monitoring. Only
# works if this service runs on the same local network as your Tempest hub -
# it's LAN broadcast traffic, not internet-routable.
# TEMPEST_UDP_ENABLED=true
# TEMPEST_UDP_PORT=50222
# TEMPEST_HUB_SERIAL=HB-00000000

# Optional: alerts (no data, frost, high wind, lightning, rain, low battery).
# Off unless a webhook URL and/or an SMTP host is set. Thresholds use the
# TEMPEST_UNITS system; defaults shown are imperial. Test with:
#   docker compose exec weather-hub python scripts/send_test_alert.py
# Webhook format: json (Slack/Discord/generic) or ntfy.
# ALERT_WEBHOOK_URL=https://ntfy.sh/your-topic
# ALERT_WEBHOOK_FORMAT=json
# ALERT_WEBHOOK_TOKEN=
# SMTP security: starttls, ssl or none.
# ALERT_SMTP_HOST=smtp.example.com
# ALERT_SMTP_PORT=587
# ALERT_SMTP_SECURITY=starttls
# ALERT_SMTP_USER=
# ALERT_SMTP_PASSWORD=
# ALERT_EMAIL_FROM=
# ALERT_EMAIL_TO=you@example.com
# ALERT_KINDS=no_data,frost,wind,lightning,rain,battery
# ALERT_NO_DATA_MINUTES=15
# ALERT_FROST_TEMPERATURE=32
# ALERT_WIND_GUST=40
# ALERT_LIGHTNING_DISTANCE=10
# ALERT_BATTERY_VOLTAGE=2.40
# ALERT_COOLDOWN_MINUTES=60
# ALERT_STATION_NAME=
